{
  "manifest_version": 3,
  "name": "VidGrab",
  "version": "0.2.0",
  "description": "Send the video on this page to the VidGrab app running on your computer.",
  "permissions": ["activeTab", "contextMenus", "notifications"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Download with VidGrab",
              "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
